{
  "entities": {
    "UserProfile": {
      "path": "users/{userId}",
      "description": "User profile with personal watchlist and preferences",
      "fields": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "watchlist": { "type": "array", "items": { "type": "string" } },
        "watchlists": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "tickers": { "type": "array", "items": { "type": "string" } },
              "isPublic": { "type": "boolean" },
              "ownerId": { "type": "string" },
              "ownerEmail": { "type": "string" }
            }
          }
        },
        "activeWatchlistIndex": { "type": "number" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      }
    },
    "PublicWatchlist": {
      "path": "public_watchlists/{watchlistId}",
      "description": "Watchlists shared publicly with all users",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tickers": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "SavedTrade": {
      "path": "users/{userId}/savedTrades/{tradeId}",
      "description": "Bookmarked options recommendations and research items",
      "fields": {
        "ticker": { "type": "string" },
        "strike": { "type": "number" },
        "expiration": { "type": "string" },
        "premium": { "type": "number" },
        "annualizedReturn": { "type": "number" },
        "downsideBuffer": { "type": "number" },
        "tier": { "type": "string" },
        "rationale": { "type": "string" },
        "savedAt": { "type": "string" }
      }
    },
    "AccessLog": {
      "path": "access_logs/{logId}",
      "description": "Audit records of all users and visitors attempting or accessing the webapp, restricted to superadmin muthu.vela@gmail.com",
      "fields": {
        "timestamp": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "userId": { "type": "string" },
        "eventType": { "type": "string" },
        "status": { "type": "string" },
        "ip": { "type": "string" },
        "userAgent": { "type": "string" },
        "path": { "type": "string" },
        "referrer": { "type": "string" },
        "device": { "type": "string" },
        "details": { "type": "string" }
      }
    },
    "ClaudeCoworkResearch": {
      "path": "claude_cowork_research/{researchId}",
      "description": "Inbound research analysis, options flow, and market reports posted from Claude Cowork or external AI agents",
      "fields": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "tickers": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" },
        "author": { "type": "string" },
        "payload": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
